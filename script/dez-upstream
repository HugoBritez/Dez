#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: %s [--check | --prepare]\n' "$0"
    printf 'Check stable Zed releases, or merge the latest into a new update branch.\n'
}

mode="${1:---check}"
if [[ $# -gt 1 ]]; then
    usage >&2
    exit 2
fi
case "$mode" in
    --check | --prepare) ;;
    --help | -h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

for dependency in git gh; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        printf 'Required command not found: %s\n' "$dependency" >&2
        exit 1
    fi
done

repository_root=$(git -C "$(dirname "${BASH_SOURCE[0]}")/.." rev-parse --show-toplevel)
cd "$repository_root"

case "$(git remote get-url upstream)" in
    https://github.com/zed-industries/zed | https://github.com/zed-industries/zed.git | git@github.com:zed-industries/zed.git) ;;
    *) printf 'The upstream remote must point to zed-industries/zed.\n' >&2; exit 1 ;;
esac

git rev-parse --verify 'refs/heads/dev^{commit}' >/dev/null

if [[ "$mode" == --prepare ]]; then
    if [[ "$(git branch --show-current)" != dev ]]; then
        printf 'Switch to dev before preparing an update.\n' >&2
        exit 1
    fi
    if [[ -n "$(git status --porcelain)" ]]; then
        printf 'The working tree must be clean before preparing an update.\n' >&2
        exit 1
    fi
    git fetch --no-tags origin refs/heads/dev:refs/remotes/origin/dev
    if [[ "$(git rev-parse dev)" != "$(git rev-parse origin/dev)" ]]; then
        printf 'Local dev and origin/dev differ. Reconcile them before preparing an update.\n' >&2
        exit 1
    fi
fi

release_tag=$(gh api repos/zed-industries/zed/releases/latest --jq '.tag_name')
if [[ ! "$release_tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'Unexpected stable release tag: %s\n' "$release_tag" >&2
    exit 1
fi

git fetch --no-tags upstream "refs/tags/$release_tag:refs/tags/$release_tag"
release_commit=$(git rev-parse "refs/tags/$release_tag^{commit}")
printf 'Latest stable Zed release: %s (%s)\n' "$release_tag" "$release_commit"

if git merge-base --is-ancestor "$release_commit" dev; then
    printf 'Local dev already contains this release.\n'
    exit 0
else
    merge_status=$?
    if [[ "$merge_status" -ne 1 ]]; then
        exit "$merge_status"
    fi
fi

if [[ "$mode" == --check ]]; then
    printf 'Local dev does not contain this release. Run %s --prepare from a clean, synchronized dev.\n' "$0"
    exit 0
fi

update_branch="update/zed-$release_tag"
git switch --create "$update_branch"
if ! git merge --no-ff --no-edit "$release_commit"; then
    printf 'The merge did not complete. Inspect git status on %s before continuing.\n' "$update_branch" >&2
    printf 'Resolve conflicts and commit, or use git merge --abort if a merge is in progress.\n' >&2
    exit 1
fi

printf 'Prepared %s. Review, build, and test before publishing a PR to HugoBritez/Dez:dev.\n' "$update_branch"
